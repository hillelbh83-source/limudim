{"1":{"1.1":"(\n        <div className=\"max-w-4xl mx-auto px-6 py-10 text-right space-y-12\" dir=\"rtl\">\n            \n            <header className=\"rounded-2xl bg-gradient-to-br from-indigo-900 to-indigo-800 text-white border border-indigo-700 p-10 shadow-xl relative overflow-hidden\">\n                <div className=\"absolute top-0 right-0 w-64 h-64 bg-indigo-500/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2\"></div>\n                \n                <p className=\"text-indigo-300 font-bold mb-2 tracking-wide uppercase text-sm\">קורס אותות ומערכות • שיעור 1 • סעיף 1.1</p>\n                <h1 className=\"text-4xl md:text-5xl font-black mt-2 leading-tight\">\n                    מבוא לאלגברה ליניארית, מרחבי אותות ונורמות\n                </h1>\n                <p className=\"text-xl text-indigo-100 mt-5 leading-relaxed max-w-2xl font-medium\">\n                    קורס זה עוסק בניתוח אותות ומערכות, ולשם כך אנו נדרשים לכלים מתמטיים שיתארו אותם בצורה מלאה. אלגברה ליניארית מספקת את המסגרת המושלמת לניתוח טורי התמרות פורייה.\n                </p>\n            </header>\n\n            {/* Vector Spaces */}\n            <section className=\"space-y-6\">\n                <div className=\"flex items-center gap-3 mb-6\">\n                    <div className=\"p-2 bg-indigo-100 dark:bg-indigo-900/40 text-indigo-600 dark:text-indigo-400 rounded-lg\">\n                        <Network className=\"w-6 h-6\" />\n                    </div>\n                    <h2 className=\"text-2xl font-bold text-slate-900 dark:text-white\">מרחב וקטורי (Vector Space)</h2>\n                </div>\n\n                <div className=\"bg-white dark:bg-slate-900 p-6 rounded-2xl border-r-[6px] border-indigo-500 shadow-sm\">\n                    <p className=\"text-lg text-slate-700 dark:text-slate-300 leading-relaxed mb-4\">\n                        מרחב וקטורי הוא אוסף איברים שעליהם מוגדרות פעולות של חיבור וכפל בסקלר המקיימות אקסיומות (סגירות, איבר אדיש, חוק הפילוג). \n                        באופן כללי, אם <span className=\"font-serif\">{\"$x$\"}</span> ו-<span className=\"font-serif\">{\"$y$\"}</span> הם איברים במרחב הוקטורי <span className=\"font-serif\">{\"$V$\"}</span>, ו-<span className=\"font-serif\">{\"$\\\\alpha$\"}</span> ו-<span className=\"font-serif\">{\"$\\\\beta$\"}</span> הם סקלרים מתוך שדה (הממשיים או המרוכבים), אז תמיד:\n                    </p>\n                    <div className=\"bg-slate-50 dark:bg-slate-800 py-3 rounded-lg text-center font-serif font-bold text-xl my-4 text-slate-900 dark:text-white border border-slate-200 dark:border-slate-700\">\n                        {`$$ \\\\alpha x + \\\\beta y \\\\in V $$`}\n                    </div>\n                </div>\n\n                <div className=\"grid md:grid-cols-2 gap-6 mt-6\">\n                    {/* Discrete Signals Space */}\n                    <div className=\"bg-white dark:bg-slate-900 rounded-2xl p-6 border border-slate-200 dark:border-slate-700 shadow-sm relative hover:-translate-y-1 transition-transform\">\n                        <div className=\"absolute top-4 left-4 text-emerald-500/30\"><ActivitySquare className=\"w-12 h-12\" /></div>\n                        <h3 className=\"text-lg font-bold text-slate-900 dark:text-white mb-3\">מרחב האותות הבדידים (<span className=\"font-serif\">{\"$\\\\ell^2$\"}</span>)</h3>\n                        <p className=\"text-slate-700 dark:text-slate-300 text-[15px] mb-3 leading-relaxed relative z-10\">\n                            מכיל את כל סדרות המספרים המסומן ב-<span className=\"font-serif\">{\"$L$\"}</span> בעלות אנרגיה שסכומה <strong className=\"text-emerald-600 dark:text-emerald-400\">סופי</strong>:\n                        </p>\n                        <div className=\"text-center font-serif text-sm bg-slate-50 dark:bg-slate-800 p-3 rounded-lg relative z-10 border border-slate-100 dark:border-slate-700\">\n                            {`$$ L = \\\\left\\\\{ x[n] \\\\mid n \\\\in \\\\mathbb{Z}, \\\\sum_{n=-\\\\infty}^{\\\\infty} |x[n]|^2 < \\\\infty \\\\right\\\\} $$`}\n                        </div>\n                    </div>\n\n                    {/* Continuous Signals Space */}\n                    <div className=\"bg-white dark:bg-slate-900 rounded-2xl p-6 border border-slate-200 dark:border-slate-700 shadow-sm relative hover:-translate-y-1 transition-transform\">\n                        <div className=\"absolute top-4 left-4 text-blue-500/30\"><Activity className=\"w-12 h-12\" /></div>\n                        <h3 className=\"text-lg font-bold text-slate-900 dark:text-white mb-3\">מרחב האותות הרציפים (<span className=\"font-serif\">{\"$L^2$\"}</span>)</h3>\n                        <p className=\"text-slate-700 dark:text-slate-300 text-[15px] mb-3 leading-relaxed relative z-10\">\n                            מסומן ב-<span className=\"font-serif\">{\"$\\\\mathcal{L}$\"}</span> ומכיל את כל הפונקציות ברצף הזמן שניחנות באנרגיה <strong className=\"text-blue-600 dark:text-blue-400\">סופית</strong>:\n                        </p>\n                        <div className=\"text-center font-serif text-sm bg-slate-50 dark:bg-slate-800 p-3 rounded-lg relative z-10 border border-slate-100 dark:border-slate-700\">\n                            {`$$ \\\\mathcal{L} = \\\\left\\\\{ x(t) \\\\mid t \\\\in \\\\mathbb{R}, \\\\int_{-\\\\infty}^{\\\\infty} |x(t)|^2 dt < \\\\infty \\\\right\\\\} $$`}\n                        </div>\n                    </div>\n                </div>\n\n                <div className=\"bg-emerald-50 dark:bg-emerald-900/10 p-5 rounded-2xl border border-emerald-200 dark:border-emerald-800 text-emerald-900 dark:text-emerald-200 font-bold text-center mx-auto max-w-3xl shadow-sm\">\n                    הערה: בקורס אנו נתמקד במרחבים המאכלסים אך ורק אותות בעלי אנרגיה סופית \n                    (<span className=\"font-serif font-black mx-1\">{\"$E_x < \\\\infty$\"}</span>).\n                </div>\n            </section>\n\n            {/* Norms */}\n            <section className=\"space-y-6 pt-10 border-t border-slate-200 dark:border-slate-800\">\n                <div className=\"flex items-center gap-3 mb-6\">\n                    <h2 className=\"text-2xl font-bold text-slate-900 dark:text-white\">נורמה של אות (Norm)</h2>\n                </div>\n\n                <p className=\"text-lg text-slate-700 dark:text-slate-300 leading-relaxed font-medium\">\n                    נורמה מסמנת את ה\"אורך\" או העוצמה של הוקטור (האות). לאותות יש צורות רבות למדוד זאת:\n                </p>\n\n                <div className=\"grid md:grid-cols-2 gap-4\">\n                    <div className=\"bg-slate-50 dark:bg-slate-900 p-5 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm relative overflow-hidden\">\n                        <div className=\"absolute top-0 right-0 w-1 h-full bg-rose-400\"></div>\n                        <h4 className=\"font-bold text-slate-900 dark:text-white mb-2\">נורמה 1 (L1)</h4>\n                        <p className=\"text-sm text-slate-600 dark:text-slate-400 mb-2\">סכום הערכים המוחלטים של הרכיבים.</p>\n                        <div className=\"font-serif text-center bg-white dark:bg-slate-800 rounded py-2\">\n                            {`$$ ||x||_1 = \\\\sum_{n=-\\\\infty}^{\\\\infty} |x[n]| $$`}\n                        </div>\n                    </div>\n\n                    <div className=\"bg-slate-50 dark:bg-slate-900 p-5 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm relative overflow-hidden\">\n                        <div className=\"absolute top-0 right-0 w-1 h-full bg-teal-500\"></div>\n                        <h4 className=\"font-bold text-slate-900 dark:text-white mb-2\">נורמה 2 (L2) - אנרגיה</h4>\n                        <p className=\"text-sm text-slate-600 dark:text-slate-400 mb-2\">קשורה ישירות לאנרגיה של האות <span className=\"font-serif\">{\"$||x||_2 = \\\\sqrt{E_x}$\"}</span>.</p>\n                        <div className=\"font-serif text-center bg-white dark:bg-slate-800 rounded py-2\">\n                            {`$$ ||x||_2 = \\\\sqrt{\\\\sum_{n=-\\\\infty}^{\\\\infty} |x[n]|^2} $$`}\n                        </div>\n                    </div>\n\n                    <div className=\"bg-slate-50 dark:bg-slate-900 p-5 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm relative overflow-hidden\">\n                        <div className=\"absolute top-0 right-0 w-1 h-full bg-sky-500\"></div>\n                        <h4 className=\"font-bold text-slate-900 dark:text-white mb-2\">נורמה p (Lp)</h4>\n                        <p className=\"text-sm text-slate-600 dark:text-slate-400 mb-2\">משוואה מוכללת לכל <span className=\"font-serif\">p</span> חיובי.</p>\n                        <div className=\"font-serif text-center bg-white dark:bg-slate-800 rounded py-2\">\n                            {`$$ ||x||_p = \\\\left( \\\\sum_{n=-\\\\infty}^{\\\\infty} |x[n]|^p \\\\right)^{\\\\frac{1}{p}} $$`}\n                        </div>\n                    </div>\n\n                    <div className=\"bg-slate-50 dark:bg-slate-900 p-5 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm relative overflow-hidden\">\n                        <div className=\"absolute top-0 right-0 w-1 h-full bg-amber-500\"></div>\n                        <h4 className=\"font-bold text-slate-900 dark:text-white mb-2\">נורמה אינסוף (Chebyshev)</h4>\n                        <p className=\"text-sm text-slate-600 dark:text-slate-400 mb-2\">החסם העליון (האמפליטודה המקסימלית). בודקת רוויה!</p>\n                        <div className=\"font-serif text-center bg-white dark:bg-slate-800 rounded py-2\">\n                            {`$$ ||x||_\\\\infty = \\\\sup_{n} |x[n]| $$`}\n                        </div>\n                    </div>\n                </div>\n            </section>\n\n            {/* Calculations Example */}\n            <section className=\"bg-slate-900 text-white p-8 rounded-3xl shadow-xl mt-12 relative overflow-hidden\">\n                <h3 className=\"text-2xl font-bold mb-6 relative z-10 text-slate-100 border-b border-slate-700 pb-2 inline-block\">דוגמה לחישוב נורמות במרחב סופי (אות מלבני סופי)</h3>\n                \n                <p className=\"mb-6 text-slate-300 relative z-10 text-lg\">\n                    האם אות יכול להתבדר תחת נורמה אחת אך להיות מוכל באחרת? כן! אך מה קורה לאות מוגבל בזמן?<br/>\n                    נניח אות <span className=\"font-serif text-sky-300\">{\"$x[n] = 1$\"}</span> עבור <span className=\"font-serif text-sky-300\">{\"$n \\\\in \\\\{-N, \\\\dots, N\\\\}$\"}</span> ו-<span className=\"font-serif text-sky-300\">{\"$0$\"}</span> אחרת:\n                </p>\n\n                <ul className=\"space-y-4 font-serif text-lg bg-slate-800/80 p-6 rounded-2xl relative z-10 border border-slate-700\">\n                    <li className=\"flex justify-between items-center bg-slate-900 p-3 rounded-lg\">\n                        <span className=\"text-slate-400\">L1</span>\n                        <span className=\"font-bold\">{\"$$ ||x||_1 = \\\\sum_{n=-N}^{N} 1 = 2N + 1 $$\"}</span>\n                    </li>\n                    <li className=\"flex justify-between items-center bg-slate-900 p-3 rounded-lg\">\n                        <span className=\"text-slate-400\">L2</span>\n                        <span className=\"font-bold\">{\"$$ ||x||_2 = \\\\sqrt{\\\\sum_{n=-N}^{N} 1^2} = \\\\sqrt{2N + 1} $$\"}</span>\n                    </li>\n                    <li className=\"flex justify-between items-center bg-slate-900 p-3 rounded-lg\">\n                        <span className=\"text-slate-400\">L3</span>\n                        <span className=\"font-bold\">{\"$$ ||x||_3 = (2N + 1)^{1/3} $$\"}</span>\n                    </li>\n                    <li className=\"flex justify-between items-center bg-slate-900 p-3 rounded-lg\">\n                        <span className=\"text-amber-400 font-sans\">L-infinity</span>\n                        <span className=\"font-bold\">{\"$$ ||x||_\\\\infty = \\\\sup_n |x[n]| = 1 $$\"}</span>\n                    </li>\n                </ul>\n            </section>\n\n        </div>\n    )","1.2":"(\n        <div className=\"max-w-4xl mx-auto px-6 py-10 text-right space-y-12\" dir=\"rtl\">\n            \n            <header className=\"rounded-2xl bg-gradient-to-br from-cyan-50 to-blue-50 dark:from-slate-900 dark:to-slate-800 border border-cyan-200/50 dark:border-slate-800 p-8 shadow-sm\">\n                <p className=\"text-sm font-medium text-cyan-600 dark:text-cyan-400 mb-2\">קורס אותות ומערכות • שיעור 1 • סעיף 1.2</p>\n                <h1 className=\"text-4xl font-black text-slate-900 dark:text-white mt-2 leading-tight\">\n                    מכפלה פנימית לאותות רציפים ובדידים\n                </h1>\n                <p className=\"text-xl text-slate-600 dark:text-slate-400 mt-4 leading-relaxed max-w-2xl\">\n                    הרחבה של המכפלה הסקלרית מהמרחבים הסופיים למרחבים בהם אות חי לאורך כל ציר הזמן. המכפלה הפנימית היא הכלי שמודד עד כמה שני אותות \"דומים\" זה לזה.\n                </p>\n            </header>\n\n            <section className=\"space-y-6\">\n                <div className=\"flex items-center gap-3 mb-6\">\n                    <div className=\"p-2 bg-cyan-100 dark:bg-cyan-900/40 text-cyan-600 dark:text-cyan-400 rounded-lg\">\n                        <Combine className=\"w-6 h-6\" />\n                    </div>\n                    <h2 className=\"text-2xl font-bold text-slate-900 dark:text-white\">מושג המכפלה הפנימית (Inner Product)</h2>\n                </div>\n\n                <p className=\"text-lg text-slate-700 dark:text-slate-300 leading-relaxed font-medium\">\n                    המכפלה הפנימית לוקחת שני אותות ומחזירה סקלר, המסמלת את ההיטל או חפיפת הכיוונים ביניהם. היא מצייתת לכללי ליניאריות וסימטריה צמודה מרוכבת.\n                </p>\n\n                <div className=\"grid md:grid-cols-2 gap-6 pb-6\">\n                    <div className=\"bg-white dark:bg-slate-900 rounded-2xl p-6 border-t-4 border-emerald-500 shadow-sm\">\n                        <h3 className=\"font-bold text-slate-900 dark:text-white text-lg mb-2\">עבור אותות בדידים (וקטורים)</h3>\n                        <p className=\"text-sm text-slate-600 dark:text-slate-400 mb-4\">סכום אינסופי המכפיל כל דרימת זמן בבן-הזוג לה בניצב המרוכב שלו.</p>\n                        <div className=\"font-serif text-center text-lg bg-slate-50 dark:bg-slate-800 py-3 border border-slate-100 dark:border-slate-700 rounded-xl font-bold text-emerald-800 dark:text-emerald-300\">\n                            {`$$ \\\\langle x, y \\\\rangle = \\\\sum_{n=-\\\\infty}^{\\\\infty} x[n] y^*[n] $$`}\n                        </div>\n                    </div>\n                    \n                    <div className=\"bg-white dark:bg-slate-900 rounded-2xl p-6 border-t-4 border-blue-500 shadow-sm\">\n                        <h3 className=\"font-bold text-slate-900 dark:text-white text-lg mb-2\">עבור אותות רציפים (פונקציות)</h3>\n                        <p className=\"text-sm text-slate-600 dark:text-slate-400 mb-4\">הסכום מוחלף באינטגרל רציף על פני ציר הזמן כולו.</p>\n                        <div className=\"font-serif text-center text-lg bg-slate-50 dark:bg-slate-800 py-3 border border-slate-100 dark:border-slate-700 rounded-xl font-bold text-blue-800 dark:text-blue-300\">\n                            {`$$ \\\\langle x, y \\\\rangle = \\\\int_{-\\\\infty}^{\\\\infty} x(t) y^*(t) dt $$`}\n                        </div>\n                    </div>\n                </div>\n\n                <div className=\"bg-rose-50 dark:bg-rose-900/10 p-5 rounded-2xl border border-rose-200 dark:border-rose-900 text-rose-900 dark:text-rose-200 shadow-sm flex items-start gap-4 mx-auto max-w-3xl tooltip relative\">\n                    <strong className=\"shrink-0 pt-1 text-rose-600\">שים לב!</strong>\n                    <span>\n                        הצמוד המרוכב על <span className=\"font-serif\">{\"$y^*[n]$\"}</span> חיוני! מבלי הצמוד על האיבר השני, מכפלה פנימית של וקטור מרוכב <span className=\"underline\">בעצמו</span> (כלומר <span className=\"font-serif\">{\"$z \\\\cdot z$\"}</span> במקום <span className=\"font-serif\">{\"$z \\\\cdot z^*$\"}</span>) עלולה לא להחזיר מספר ממשי אי-שלילי. הנוסחה מבטיחה שנקבל ריבוע ערך מוחלט התואם את מושג האנרגיה.\n                    </span>\n                </div>\n            </section>\n\n            <section className=\"pt-8 border-t border-slate-200 dark:border-slate-800 space-y-6\">\n                <h3 className=\"text-2xl font-bold text-slate-900 dark:text-white mb-6\">תכונות מרכזיות למכפלה פנימית</h3>\n                \n                <div className=\"space-y-4\">\n                    \n                    <div className=\"p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col md:flex-row gap-6 md:items-center\">\n                        <div className=\"font-serif font-bold text-xl min-w-[200px] text-center bg-slate-50 dark:bg-slate-800 py-2 rounded-lg text-indigo-700 dark:text-indigo-400\">\n                            {`$$ \\\\langle x, x \\\\rangle = ||x||_2^2 = E_x $$`}\n                        </div>\n                        <div>\n                            <strong className=\"text-slate-900 dark:text-white text-lg block mb-1\">זהות אנרגטית מוחלטת</strong>\n                            <p className=\"text-slate-600 dark:text-slate-400 text-sm\">מכפלה פנימית של אות בעצמו נותנת תמיד את האנרגיה הכללית שלו (ריבוע נורמה 2), כפועל יוצא ישיר של כך ש- <span className=\"font-serif\">{\"$|z|^2 = z \\\\cdot z^*$\"}</span>.</p>\n                        </div>\n                    </div>\n\n                    <div className=\"p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col md:flex-row gap-6 md:items-center\">\n                        <div className=\"font-serif font-bold text-xl min-w-[200px] text-center bg-slate-50 dark:bg-slate-800 py-2 rounded-lg text-rose-700 dark:text-rose-400\">\n                            {`$$ \\\\langle x, y \\\\rangle = \\\\langle y, x \\\\rangle^* $$`}\n                        </div>\n                        <div>\n                            <strong className=\"text-slate-900 dark:text-white text-lg block mb-1\">סדר הוקטורים קריטי בהחלט</strong>\n                            <p className=\"text-slate-600 dark:text-slate-400 text-sm\">בניגוד לאלגברה של ממשיים היכן שהסדר לא משנה, באותות מרוכבים חילוף סדר הוריאבלים ממפעיל את פעולת הצמוד המרוכב על התוצאה כולה. נא לזכור זאת!</p>\n                        </div>\n                    </div>\n\n                    <div className=\"p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col md:flex-row gap-6 md:items-center\">\n                        <div className=\"font-serif font-bold text-xl min-w-[200px] text-center bg-slate-50 dark:bg-slate-800 py-2 rounded-lg text-teal-700 dark:text-teal-400\">\n                            {`$$ x \\\\perp y \\\\iff \\\\langle x, y \\\\rangle = 0 $$`}\n                        </div>\n                        <div>\n                            <strong className=\"text-slate-900 dark:text-white text-lg block mb-1\">אורתוגונליות (ניצבות)</strong>\n                            <p className=\"text-slate-600 dark:text-slate-400 text-sm\">כשם שפעמיים כוח במאונך אינם מבצעים עבודה אחד על השני, כך אותות שהמכפלה הפנימית ביניהם אפס – לחלוטין אינם חולקים רכיב מאותו המרחב. הם נקראים אורתוגונלים.</p>\n                        </div>\n                    </div>\n\n                    <div className=\"p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col md:flex-row gap-6 md:items-center\">\n                        <div className=\"font-serif font-bold text-lg min-w-[200px] text-center bg-slate-50 dark:bg-slate-800 py-2 rounded-lg text-amber-700 dark:text-amber-400 px-3\">\n                            {`$$ \\\\langle \\\\alpha x + \\\\beta y, z \\\\rangle = \\\\alpha \\\\langle x, z \\\\rangle + \\\\beta \\\\langle y, z \\\\rangle $$`}\n                        </div>\n                        <div>\n                            <strong className=\"text-slate-900 dark:text-white text-lg block mb-1\">ליניאריות ברכיב הראשון</strong>\n                            <p className=\"text-slate-600 dark:text-slate-400 text-sm\">המכפלה פועלת באופן ליניארי מושלם על הוקטור הראשון. הערה: על הוקטור השני הסקלרים יצאו עם צמוד מרוכב (ליניאריות-מצומדת).</p>\n                        </div>\n                    </div>\n\n                </div>\n            </section>\n        </div>\n    )","1.3":"(\n        <div className=\"max-w-4xl mx-auto px-6 py-10 text-right space-y-12\" dir=\"rtl\">\n            \n            <header className=\"rounded-2xl bg-gradient-to-br from-purple-900 to-fuchsia-900 text-white border border-purple-700 p-8 shadow-xl\">\n                <p className=\"text-purple-300 font-bold mb-2 text-sm\">קורס אותות ומערכות • שיעור 1 • סעיף 1.3</p>\n                <h1 className=\"text-4xl font-black mt-2 leading-tight\">\n                    בסיסים, אורתוגונליות והטלה (Projection)\n                </h1>\n                <p className=\"text-xl text-purple-100 mt-4 leading-relaxed max-w-2xl\">\n                    כיצד ניתן לייצג אות כלשהו כסכום של אותות פשוטים יותר? כאן אנו מגדירים כיצד לבחור את \"אבני הבניין\" המרחביות שלנו וכיצד לגזור מהן כל וקטור באמצעות פעולת ההטלה המופשטת.\n                </p>\n            </header>\n\n            {/* Basis definitions */}\n            <section className=\"space-y-6\">\n                <div className=\"flex items-center gap-3 mb-6\">\n                    <div className=\"p-2 bg-purple-100 dark:bg-purple-900/40 text-purple-600 dark:text-purple-400 rounded-lg\">\n                        <Columns3 className=\"w-6 h-6\" />\n                    </div>\n                    <h2 className=\"text-2xl font-bold text-slate-900 dark:text-white\">בסיס למרחב וקטורי</h2>\n                </div>\n\n                <div className=\"bg-white dark:bg-slate-900 p-8 rounded-3xl border border-slate-200 dark:border-slate-700 shadow-sm\">\n                    <p className=\"text-lg text-slate-700 dark:text-slate-300 leading-relaxed mb-6 font-medium\">\n                        בסיס הוא קבוצה <strong className=\"text-purple-600 dark:text-purple-400\">בלתי-תלויה ליניארית (בת\"ל)</strong> שפורשת מרחב. אם מסמנים את איברי הבסיס בעזרת <span className=\"font-serif\">{\"$\\\\{v_1, v_2, \\\\dots, v_n\\\\}$\"}</span>, אזי כל אות <span className=\"font-serif\">{\"$x$\"}</span> במרחב ניתן לייצוג באופן <strong className=\"text-indigo-600 dark:text-indigo-400\">יחידי</strong> על ידי הצירוף הבא:\n                    </p>\n\n                    <div className=\"font-serif text-center text-3xl font-black text-slate-900 dark:text-white bg-slate-50 dark:bg-slate-800 py-6 rounded-2xl border-l-[8px] border-purple-500 shadow-inner mb-6\">\n                        {`$$ x = \\\\sum_{i} \\\\alpha_i v_i $$`}\n                    </div>\n\n                    <p className=\"text-slate-600 dark:text-slate-400\">\n                        הסקלרים <span className=\"font-serif font-bold text-purple-600 dark:text-purple-400\">{\"$\\\\alpha_i$\"}</span> נקראים גם \"הקואורדינטות של <span className=\"font-serif\">{\"$x$\"}</span>\" לפי הבסיס הנתון, או <strong>מקדמי ההטלה</strong>.\n                    </p>\n                </div>\n            </section>\n\n            {/* Types of Basis */}\n            <section className=\"pt-8 border-t border-slate-200 dark:border-slate-800 space-y-6\">\n                <div className=\"grid md:grid-cols-2 gap-6\">\n                    <div className=\"bg-slate-50 dark:bg-slate-900 rounded-2xl p-6 border-t-4 border-indigo-400 shadow-sm hover:shadow-md transition\">\n                        <h3 className=\"text-xl font-bold text-slate-900 dark:text-white mb-2 flex items-center gap-2\">\n                            <span className=\"text-indigo-500\">◆</span>\n                            בסיס אורתוגונלי (Orthogonal)\n                        </h3>\n                        <p className=\"text-slate-700 dark:text-slate-300 text-[15px] mb-4\">\n                            כל שני וקטורים שונים במרחב ניצבים לחלוטין זה לזה. אם נעשה מכפלה פנימית בין אבני הבסיס:\n                        </p>\n                        <div className=\"bg-white dark:bg-slate-800 p-3 rounded-lg text-center font-serif font-bold text-indigo-700 dark:text-indigo-300\">\n                            {`$$ i \\\\ne j \\\\implies \\\\langle v_i, v_j \\\\rangle = 0 $$`}\n                        </div>\n                    </div>\n\n                    <div className=\"bg-slate-50 dark:bg-slate-900 rounded-2xl p-6 border-t-4 border-fuchsia-400 shadow-sm hover:shadow-md transition\">\n                        <h3 className=\"text-xl font-bold text-slate-900 dark:text-white mb-2 flex items-center gap-2\">\n                            <span className=\"text-fuchsia-500\">■</span>\n                            בסיס אורתונורמלי (Orthonormal)\n                        </h3>\n                        <p className=\"text-slate-700 dark:text-slate-300 text-[15px] mb-4\">\n                            נוסף על הניצבות (אורתוגונליות), אבן היסוד מנורמלת בדיוק לאנרגיה וגודל של יחידה 1:\n                        </p>\n                        <div className=\"bg-white dark:bg-slate-800 p-3 rounded-lg text-center font-serif font-bold text-fuchsia-700 dark:text-fuchsia-300\">\n                            {`$$ \\\\langle v_i, v_i \\\\rangle = ||v_i||_2^2 = 1 $$`}\n                        </div>\n                    </div>\n                </div>\n            </section>\n\n            {/* Projections Proof */}\n            <section className=\"pt-8 border-t border-slate-200 dark:border-slate-800 space-y-6\">\n                <div className=\"flex items-center gap-3 mb-6\">\n                    <div className=\"p-2 bg-indigo-100 dark:bg-indigo-900/40 text-indigo-600 dark:text-indigo-400 rounded-lg\">\n                        <Target className=\"w-6 h-6\" />\n                    </div>\n                    <h2 className=\"text-2xl font-bold text-slate-900 dark:text-white\">הטלה (Projection) וממצאי הקואורדינטות</h2>\n                </div>\n\n                <div className=\"bg-indigo-50 dark:bg-indigo-900/10 p-8 rounded-3xl border border-indigo-200 dark:border-indigo-800/50 shadow-inner\">\n                    <p className=\"text-lg font-medium text-indigo-900 dark:text-indigo-200 mb-6\">\n                        אנו יודעים כי <span className=\"font-serif\">{\"$x = \\\\sum \\\\alpha_i v_i$\"}</span>. אך כיצד בפועל \"נקלף\" ונמצא את המקדם <span className=\"font-serif font-bold text-rose-500\">{\"$\\\\alpha_k$\"}</span> של וקטור הבסיס <span className=\"font-serif\">{\"$v_k$\"}</span> במרחב אורתוגונלי? <br/>נעשה זאת בהקשה אנליטית באמצעות המכפלה הפנימית!\n                    </p>\n\n                    <div className=\"space-y-4\">\n                        <div className=\"flex items-center gap-4 bg-white dark:bg-slate-900 p-4 rounded-xl shadow-sm\">\n                            <div className=\"text-indigo-400 font-bold shrink-0 w-8\">1.</div>\n                            <div className=\"flex-1 font-serif text-slate-800 dark:text-slate-200\">{\"$$ \\\\langle x, v_k \\\\rangle = \\\\left\\\\langle \\\\sum_i \\\\alpha_i v_i, v_k \\\\right\\\\rangle $$\"}</div>\n                            <div className=\"text-sm text-slate-500 w-32 text-right\">נכפיל פנימית ב-<span className=\"font-serif\">v_k</span></div>\n                        </div>\n\n                        <div className=\"flex items-center gap-4 bg-white dark:bg-slate-900 p-4 rounded-xl shadow-sm\">\n                            <div className=\"text-indigo-400 font-bold shrink-0 w-8\">2.</div>\n                            <div className=\"flex-1 font-serif text-slate-800 dark:text-slate-200\">{\"$$ \\\\langle x, v_k \\\\rangle = \\\\sum_i \\\\alpha_i \\\\langle v_i, v_k \\\\rangle $$\"}</div>\n                            <div className=\"text-sm text-slate-500 w-32 text-right\">נוציא לפי סופרפוזיציה</div>\n                        </div>\n\n                        <div className=\"flex items-center gap-4 bg-white dark:bg-slate-900 p-4 rounded-xl shadow-sm\">\n                            <div className=\"text-indigo-400 font-bold shrink-0 w-8\">3.</div>\n                            <div className=\"flex-1 font-serif text-slate-800 dark:text-slate-200\">{\"$$ \\\\langle x, v_k \\\\rangle = \\\\alpha_k \\\\langle v_k, v_k \\\\rangle $$\"}</div>\n                            <div className=\"text-sm text-slate-500 w-32 text-right\">כיוון שאורתוגונלי - כולם מתאפסים מלבד עצמו!</div>\n                        </div>\n                    </div>\n\n                    <div className=\"mt-8 pt-6 border-t border-indigo-200 dark:border-indigo-800/50\">\n                        <div className=\"text-center\">\n                            <span className=\"text-slate-600 dark:text-slate-400 font-bold mb-2 block\">הנוסחה הסופית למקדם ההטלה האורתוגונלי הוא:</span>\n                            <div className=\"font-serif font-black text-3xl bg-indigo-600 dark:bg-indigo-500 text-white py-6 rounded-2xl shadow-xl border-b-4 border-indigo-800 dark:border-indigo-700\">\n                                {`$$ \\\\alpha_k = \\\\frac{\\\\langle x, v_k \\\\rangle}{\\\\langle v_k, v_k \\\\rangle} = \\\\frac{\\\\langle x, v_k \\\\rangle}{||v_k||_2^2} $$`}\n                            </div>\n                        </div>\n                        \n                        <div className=\"mt-6 flex items-start gap-4\">\n                            <Expand className=\"w-6 h-6 text-fuchsia-500 shrink-0 mt-1\" />\n                            <p className=\"text-[15px] text-indigo-900 dark:text-indigo-300 leading-relaxed font-medium\">\n                                <strong>ואם הבסיס הוא גם אורתונורמלי?</strong> החיים קלים יותר! המכנה הופך ל-1 (<span className=\"font-serif opacity-75\">{\"$||v_k||_2^2=1$\"}</span>) ולכן מקבלים את הנוסחה השלמה:\n                                <span className=\"font-serif block mt-2 text-xl font-bold text-indigo-950 dark:text-white\">{\"$$ \\\\alpha_k = \\\\langle x, v_k \\\\rangle $$\"}</span>\n                            </p>\n                        </div>\n                    </div>\n                </div>\n\n            </section>\n        </div>\n    )","1.4":"(\n        <div className=\"max-w-4xl mx-auto px-6 py-10 text-right space-y-12\" dir=\"rtl\">\n            \n            <header className=\"rounded-2xl bg-slate-900 text-white p-8 shadow-xl relative overflow-hidden border border-slate-700\">\n                <div className=\"absolute top-0 right-0 h-full w-2 bg-gradient-to-b from-yellow-400 to-orange-500\"></div>\n                <div className=\"absolute right-[-40px] top-[-40px] opacity-10\"><Scale className=\"w-64 h-64\" /></div>\n                \n                <p className=\"text-slate-400 font-bold mb-2 text-sm relative z-10\">קורס אותות ומערכות • שיעור 1 • סעיף 1.4</p>\n                <h1 className=\"text-4xl font-black mt-2 leading-tight relative z-10 text-yellow-400\">\n                    משפט פלנשרל-פרסבל (Parseval)\n                </h1>\n                <p className=\"text-xl text-slate-300 mt-4 leading-relaxed max-w-2xl relative z-10\">\n                    חוק שימור האנרגיה בטבע תקף גם באלגברה! משמעות המשפט היא שהאנרגיה בייצוג של מרחב הזמן שווה לחלוטין לאנרגיה בייצוג של הבסיס החדש (מרחב התדר או כל מרחב אורתוגונלי אחר).\n                </p>\n            </header>\n\n            <section className=\"space-y-6\">\n                <div className=\"bg-gradient-to-br from-yellow-50 to-amber-50 dark:from-yellow-900/10 dark:to-orange-900/10 p-8 rounded-3xl border border-yellow-200 dark:border-yellow-700/50 shadow-sm relative\">\n                    <div className=\"absolute top-4 left-4 text-amber-500/20\"><Zap className=\"w-16 h-16\" /></div>\n                    \n                    <h2 className=\"text-2xl font-bold text-amber-900 dark:text-amber-500 mb-6\">חוק שימור האנרגיה לפי פרסבל</h2>\n                    \n                    <p className=\"text-lg text-slate-800 dark:text-slate-200 leading-relaxed mb-6 relative z-10 font-medium\">\n                        משפט פלנשרל מדבר על שימור אנרגיה בעת החלפת בסיס. האנרגיה של אות בסכימה הבסיסית הכללית – שווה לריבוע סכום כל האמפליטודות בהטלות שלו לאחר כל החישובים, במילים אחרות: אנו מחשבים אנרגיה לפי המקדמים במקום הפונקציה המקורית.\n                    </p>\n\n                    <div className=\"font-serif text-center font-black text-3xl text-slate-900 dark:text-white bg-white dark:bg-slate-900 py-6 rounded-2xl shadow-inner my-6 relative z-10 border border-amber-200 dark:border-amber-800/50\">\n                        {`$$ ||x||_2^2 = \\\\sum_k |\\\\alpha_k|^2 ||v_k||_2^2 $$`}\n                    </div>\n                </div>\n            </section>\n\n            <section className=\"pt-8 border-t border-slate-200 dark:border-slate-800 space-y-6\">\n                <h2 className=\"text-2xl font-bold text-slate-900 dark:text-white mb-6\">הוכחת המשפט לבסיס אורתוגונלי</h2>\n                \n                <div className=\"bg-white dark:bg-slate-900 p-8 rounded-3xl border border-slate-200 dark:border-slate-700 shadow-sm overflow-hidden\">\n                    <p className=\"text-slate-600 dark:text-slate-400 mb-6 text-[15px] leading-relaxed\">\n                        ניקח את האנרגיה לפי הגדרת ריבוע הנורמה. נציב את האות מיוצג לפי פרישת אבני הבסיס האורתוגונלים שלו:\n                    </p>\n\n                    <div className=\"space-y-4\">\n                        <div className=\"bg-slate-50 dark:bg-slate-800 p-4 rounded-xl border-r-4 border-slate-300 dark:border-slate-600 font-serif text-slate-800 dark:text-slate-200 overflow-x-auto text-lg flex flex-col md:flex-row items-center gap-4\">\n                            <span className=\"shrink-0 font-bold bg-slate-200 dark:bg-slate-700 px-3 py-1 rounded text-sm text-slate-600 dark:text-slate-300 font-sans\">מהגדרה</span>\n                            <span>{`$$ \\\\|x\\\\|_2^2 = \\\\langle x, x \\\\rangle = \\\\left\\\\langle \\\\sum_i \\\\alpha_i v_i, \\\\sum_j \\\\alpha_j v_j \\\\right\\\\rangle $$`}</span>\n                        </div>\n\n                        <div className=\"bg-slate-50 dark:bg-slate-800 p-4 rounded-xl border-r-4 border-slate-300 dark:border-slate-600 font-serif text-slate-800 dark:text-slate-200 overflow-x-auto text-lg flex flex-col md:flex-row items-center gap-4\">\n                            <span className=\"shrink-0 font-bold bg-slate-200 dark:bg-slate-700 px-3 py-1 rounded text-sm text-slate-600 dark:text-slate-300 font-sans\">ליניאריות מורחבת</span>\n                            <span>{`$$ \\\\|x\\\\|_2^2 = \\\\sum_i \\\\sum_j \\\\alpha_i \\\\alpha_j^* \\\\langle v_i, v_j \\\\rangle $$`}</span>\n                        </div>\n\n                        <div className=\"bg-emerald-50 dark:bg-emerald-900/20 p-4 rounded-xl border-r-4 border-emerald-400 font-serif text-emerald-900 dark:text-emerald-200 overflow-x-auto text-lg flex flex-col md:flex-row items-center gap-4\">\n                            <span className=\"shrink-0 font-bold bg-emerald-200 dark:bg-emerald-800 px-3 py-1 rounded text-sm text-emerald-800 dark:text-emerald-300 font-sans\">קילוף האורתוגונליות</span>\n                            <div className=\"w-full\">\n                                <span className=\"block text-sm font-sans mb-1 text-emerald-700 dark:text-emerald-400 font-medium\">מכיוון שהבסיס אורתוגונלי, כל האיברים בהם <span className=\"font-serif bg-emerald-100 dark:bg-emerald-900/50 px-1 rounded\">{\"$i \\\\ne j$\"}</span> שווים לאפס מוחלט! לכן אנו מסכמים בסוף רק על הצירים הזהים:</span>\n                                <span>{`$$ \\\\|x\\\\|_2^2 = \\\\sum_i \\\\alpha_i \\\\alpha_i^* \\\\langle v_i, v_i \\\\rangle = \\\\sum_i |\\\\alpha_i|^2 \\\\|v_i\\\\|_2^2 $$`}</span>\n                            </div>\n                        </div>\n                    </div>\n                    \n                    <div className=\"mt-8 text-center text-slate-500 font-bold tracking-widest leading-none\">\n                        ∎ מש\"ל\n                    </div>\n                </div>\n\n            </section>\n        </div>\n    )","1.5":"(\n        <div className=\"max-w-4xl mx-auto px-6 py-10 text-right space-y-12\" dir=\"rtl\">\n            \n            <header className=\"rounded-2xl bg-gradient-to-br from-indigo-50 to-emerald-50 dark:from-slate-900 dark:to-slate-800 border border-emerald-200/50 dark:border-slate-700 p-8 shadow-sm\">\n                <p className=\"text-sm font-bold text-emerald-600 dark:text-emerald-400 mb-2 uppercase tracking-wide\">קורס אותות ומערכות • שיעור 1 • סעיף 1.5</p>\n                <h1 className=\"text-4xl font-black text-slate-900 dark:text-white mt-2 leading-tight\">\n                    הכנה לטור פורייה: מעריכים מרוכבים\n                </h1>\n                <p className=\"text-xl text-slate-600 dark:text-slate-400 mt-4 leading-relaxed max-w-2xl font-medium\">\n                    כאן אנו רותמים את כל הכלים שלמדנו – כדי להצדיק מתמטית את אחת מהתגליות המפורסמות בפיזיקה - המעריך המרוכב בתור אבן בניין.\n                </p>\n            </header>\n\n            {/* The Complex Exponential */}\n            <section className=\"space-y-6\">\n                <div className=\"bg-white dark:bg-slate-900 p-8 rounded-3xl border border-slate-200 dark:border-slate-700 shadow-md\">\n                    <div className=\"flex items-center gap-3 mb-4\">\n                        <Waves className=\"w-8 h-8 text-emerald-500\" />\n                        <h2 className=\"text-2xl font-bold text-slate-900 dark:text-white\">אבני הבניין של פורייה</h2>\n                    </div>\n                    \n                    <p className=\"text-lg text-slate-700 dark:text-slate-300 leading-relaxed font-medium mb-6\">\n                        טור פורייה מבוסס על האקספוננט המרוכב:\n                    </p>\n                    <div className=\"font-serif text-center font-bold text-3xl bg-slate-50 dark:bg-slate-800 py-6 rounded-2xl border border-slate-100 dark:border-slate-700 text-slate-900 dark:text-white\">\n                        {`$$ v_k[n] = e^{j \\\\frac{2\\\\pi}{N} k n} $$`}\n                    </div>\n                    \n                    <p className=\"mt-4 text-slate-600 dark:text-slate-400 leading-relaxed\">\n                        זהו בסיס של מרחב האותות הבדידים <strong>המחזוריים</strong> עם מחזור <span className=\"font-serif bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded\">N</span>. כלומר מדובר בקומבינציות הרמוניות של סינוסים וקוסינוסים. השאלה הראשונה הנשאלת: <strong>האם זהו בסיס אורתוגונלי?</strong>\n                    </p>\n                </div>\n            </section>\n\n            {/* Orthogonality Proof */}\n            <section className=\"space-y-6 pt-6\">\n                <h2 className=\"text-2xl font-bold text-slate-900 dark:text-white border-b border-slate-200 dark:border-slate-800 pb-2\">נקודת השיא: הוכחת שימור הניצבות (אורתוגונליות)</h2>\n                \n                <div className=\"space-y-4\">\n                    <div className=\"bg-white dark:bg-slate-900 rounded-2xl p-6 border border-slate-200 dark:border-slate-700 shadow-sm transition hover:border-emerald-500/50\">\n                        <h3 className=\"text-slate-500 dark:text-slate-400 text-sm font-bold uppercase tracking-widest mb-3\">1. הגדרת המכפלה למחזור שלם</h3>\n                        <p className=\"text-slate-700 dark:text-slate-300 font-medium leading-relaxed mb-3\">אנו נחשב את המכפלה הפנימית על מחזור אחד באורך <span className=\"font-serif\">{\"$N$\"}</span> (כלומר מסכימים מ- <span className=\"font-serif\">0</span> עד <span className=\"font-serif\">N-1</span>):</p>\n                        <div className=\"font-serif bg-slate-50 dark:bg-slate-800 p-4 rounded-xl overflow-x-auto text-lg text-slate-800 dark:text-slate-200 text-center\">\n                            {`$$ \\\\langle v_k, v_m \\\\rangle = \\\\sum_{n=0}^{N-1} v_k[n] v_m^*[n] = \\\\sum_{n=0}^{N-1} e^{j \\\\frac{2\\\\pi}{N} k n} e^{-j \\\\frac{2\\\\pi}{N} m n} $$`}\n                        </div>\n                    </div>\n\n                    <div className=\"bg-white dark:bg-slate-900 rounded-2xl p-6 border border-slate-200 dark:border-slate-700 shadow-sm transition hover:border-emerald-500/50\">\n                        <h3 className=\"text-slate-500 dark:text-slate-400 text-sm font-bold uppercase tracking-widest mb-3\">2. איסוף המעריכים וטור הנדסי סופי</h3>\n                        <p className=\"text-slate-700 dark:text-slate-300 font-medium leading-relaxed mb-3\">בעזרת חוקי חזקות נכנס ונקבל טור הנדסי כאשר נסמן את מנת הטור ב- <span className=\"font-serif text-emerald-600 dark:text-emerald-400\">{\"$q=e^{j \\\\frac{2\\\\pi}{N} (k-m)}$\"}</span>:</p>\n                        <div className=\"font-serif bg-slate-50 dark:bg-slate-800 p-4 rounded-xl overflow-x-auto text-lg text-slate-800 dark:text-slate-200 text-center\">\n                            {`$$ \\\\sum_{n=0}^{N-1} e^{j \\\\frac{2\\\\pi}{N} (k-m) n} = \\\\sum_{n=0}^{N-1} q^n $$`}\n                        </div>\n                    </div>\n\n                    <div className=\"bg-emerald-50 dark:bg-emerald-900/10 rounded-2xl p-6 border-2 border-emerald-400/50 shadow-sm relative overflow-hidden\">\n                        <div className=\"absolute top-0 right-0 h-full w-2 bg-emerald-500\"></div>\n                        <h3 className=\"text-emerald-800 dark:text-emerald-300 text-sm font-bold uppercase tracking-widest mb-3\">3. מבחן המכנה וההתאפסות המוחלטת</h3>\n                        <div className=\"flex flex-col lg:flex-row gap-6\">\n                            <div className=\"flex-1 space-y-4\">\n                                <div>\n                                    <strong className=\"text-slate-900 dark:text-white\">מקרה א' ( <span className=\"font-serif\">{\"$k = m$\"}</span> ):</strong>\n                                    <p className=\"text-slate-700 dark:text-slate-300 mt-1\">במקרה זה המנה היא <span className=\"font-serif\">{\"$1$\"}</span>, אז אנחנו מסכמים <span className=\"font-serif text-slate-500 font-bold ml-1\">{\"$\\\\sum 1$\"}</span> ממש <span className=\"font-serif\">{\"$N$\"}</span> פעמים! הנורמה הריבועית היא <span className=\"font-serif font-black underline\">{\"$N$\"}</span>.</p>\n                                </div>\n                                <div>\n                                    <strong className=\"text-rose-600 dark:text-rose-400\">מקרה ב' ( <span className=\"font-serif\">{\"$k \\\\ne m$\"}</span> ): פצצה מתמטית</strong>\n                                    <p className=\"text-slate-700 dark:text-slate-300 mt-1\">\n                                        סכום טור הנדסי עם מנה מרוכבת הוא: \n                                        <span className=\"font-serif block text-center my-3 bg-white dark:bg-slate-900 py-2 rounded shadow-inner text-rose-800 dark:text-rose-300\">{\"$$ \\\\frac{1-q^N}{1-q} $$\"}</span>\n                                        נבדוק את המונה בלבד! \n                                        <span className=\"font-serif block text-center mt-2 font-bold text-slate-900 dark:text-white\">{\"$$ q^N = \\\\left( e^{j \\\\frac{2\\\\pi}{N} (k-m)} \\\\right)^N = e^{j 2\\\\pi (k-m)} $$\"}</span>\n                                        כיון שההפרש ביניהם הוא מספר שלם מוחלט (פעמים <span className=\"font-serif\">{\"$2\\\\pi$\"}</span>), זה מחזיר אותנו ל- <span className=\"font-serif font-black text-emerald-600 dark:text-emerald-400\">{\"$1$\"}</span> טהור באותה נקודה. \n                                        ואז המונה מטורפד לחלוטין לכדי <span className=\"font-serif\">{\"$1-1 = 0$\"}</span> (המכפלה אכן מתאפסת!).\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </section>\n\n            {/* Application */}\n            <section className=\"bg-slate-900 text-white rounded-3xl p-8 border border-slate-700 mt-12 relative overflow-hidden shadow-xl\">\n                <div className=\"absolute opacity-5 -left-10 -bottom-10\"><Code2 className=\"w-64 h-64\" /></div>\n                \n                <h2 className=\"text-2xl font-black text-emerald-400 mb-4 inline-block border-b-2 border-slate-700 pb-2 relative z-10\">נוסחאת ה-DFT!</h2>\n                \n                <p className=\"text-lg text-slate-300 leading-relaxed mb-6 font-medium relative z-10\">\n                    מתוך הידיעה שהבסיס הזה הוא אכן אורתוגונלי (ונורמתו היא <span className=\"font-serif font-bold text-emerald-300\">N</span>), אנו תופרים את נוסחת ההטלה מסעיף 1.3 - ומגלים מיד את הקואורדינטות <span className=\"font-serif font-black mx-1\">{\"$\\\\alpha_k$\"}</span> של תדר האות!\n                </p>\n\n                <div className=\"font-serif text-center font-bold text-2xl lg:text-3xl lg:px-12 bg-slate-800/80 p-6 sm:py-8 rounded-2xl border border-slate-600 shadow-inner relative z-10 text-emerald-50\">\n                    {`$$ \\\\alpha_k = \\\\frac{\\\\langle x, v_k \\\\rangle}{\\\\langle v_k, v_k \\\\rangle} = \\\\frac{1}{N} \\\\sum_{n=0}^{N-1} x[n] e^{-j \\\\frac{2\\\\pi}{N} k n} $$`}\n                </div>\n            </section>\n\n        </div>\n    )"}}